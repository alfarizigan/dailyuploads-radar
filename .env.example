# Server settings
PORT=3456
HOST=127.0.0.1

# Default DailyUploads source username (from https://dailyuploads.net/users/<username>)
DEFAULT_SOURCE_USER=user_hidden

# Auto-sync interval in minutes (0 to disable)
SYNC_INTERVAL_MINUTES=20

# Optional: Telegram Bot (can also be configured from the Web UI Settings)
# Create a bot via @BotFather, get chat ID via @userinfobot or send /start to your bot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_BOT_ENABLED=false

# Optional: Discord or Generic Webhook URL (can also be configured in Web UI)
WEBHOOK_URL=

# Optional: Windows native toast notifications (true/false)
WINDOWS_TOAST_ENABLED=true
