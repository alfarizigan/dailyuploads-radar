{
  "name": "dailyuploads-radar",
  "version": "1.0.0",
  "description": "Smart searcher, filter, version tracker & update notifier for DailyUploads user catalogs (preconfigured for user_hidden)",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "sync:cloud": "node --no-warnings src/cloud-sync.js",
    "export:cloud": "node --no-warnings src/cloud-sync.js --export-from-sqlite",
    "ping:cloud": "node --no-warnings src/cloud-pinger.js",
    "scheduler:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-cloud-scheduler.ps1 -Action install",
    "scheduler:status": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-cloud-scheduler.ps1 -Action status",
    "scheduler:remove": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-cloud-scheduler.ps1 -Action remove",
    "test": "node --test tests/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "keywords": [
    "dailyuploads",
    "searcher",
    "ipa",
    "tracker",
    "notifier",
    "telegram-bot"
  ],
  "license": "MIT"
}
